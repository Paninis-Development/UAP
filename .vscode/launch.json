{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pascal: Aktive Datei",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "command": "mkdir -p \"${workspaceFolder}/.build/pascal\" && fpc -FU\"${workspaceFolder}/.build/pascal\" -o\"${workspaceFolder}/.build/pascal/${fileBasenameNoExtension}\" \"${file}\" && \"${workspaceFolder}/.build/pascal/${fileBasenameNoExtension}\""
        }
    ]
}
